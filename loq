#!/bin/bash

set -euo pipefail

# Set up directories
LOQ_DIR="$HOME/.loq"
TMP_DIR="$LOQ_DIR/tmp"
CONFIG_FILE="$LOQ_DIR/keys"
STATS_FILE="$LOQ_DIR/stats.tsv"
LOG_FILE="$LOQ_DIR/loq.log"
LIMITS_CACHE="$LOQ_DIR/api-limits.tsv"
HUD_TIMEOUT=2

# Ensure all required directories exist
mkdir -p "$LOQ_DIR" "$TMP_DIR" "$LOQ_DIR/recordings"
touch "$TMP_DIR/notification_id"  # Create empty notification ID file if it doesn't exist

# Function to log errors
log_error() {
  echo "$(date -u +"%Y-%m-%d %H:%M:%S") ERROR: $1" >> "$LOG_FILE"
}

# Function to display notification
notify() {
  #notify-send -t 1 -e --hint=int:transient:1 -u normal -a "loq" "$1" "$2"
  echo "[NOTIFICATION] $1: $2"
}

# Function to close notification
close_notification() {
  # No need to manage notification closing anymore
  echo "[DEBUG] Notifications are transient and auto-close"
}

# Function to start recording
start_recording() {
  close_notification
  local timestamp=$(date -u +"%Y%m%dT%H%M%SZ")
  local audio="$LOQ_DIR/recordings/$timestamp.wav"
  touch "$audio"
  echo $audio > "$TMP_DIR/audio"
  
  # Create lock file to indicate recording is in progress
  touch "$TMP_DIR/recording.lock"
  
  # Create recording-now file with timestamp
  echo "$(date -u +"%Y-%m-%d %H:%M:%S")" > "$LOQ_DIR/recording-now"
  
  # Display recording notification
  notify "Recording..." "🎙️ Recording has started"
  echo "[DEBUG] Starting recording to $audio"
  
  # Start recording
  rec -c 1 -r 16000 -t wav "$audio" &
  echo $! > "$TMP_DIR/recording_pid"
  
  # Safety auto-stop so a forgotten recording cannot run away forever.
  # Configurable via LOQ_MAX_RECORD_SECONDS (default 1 hour).
  local max_record="${LOQ_MAX_RECORD_SECONDS:-3600}"
  (sleep "$max_record" && stop_recording) &
  echo $! > "$TMP_DIR/cleanup_pid"
}

# --- Chunked transcription helpers -----------------------------------------

# Send one audio file to the transcription API. Echoes the raw transcript.
# Returns non-zero on HTTP/network failure (curl -f).
send_audio_once() {
  local file="$1"
  local prompt="${2:-}"
  local args=(-fsS -X POST
    -H "Authorization: Bearer $LOQ_API_KEY"
    -H "Content-Type: multipart/form-data"
    -F "file=@$file"
    -F "model=$LOQ_API_MODEL"
    -F "response_format=text")
  # --form-string avoids curl treating @/< in the prompt text as a file/stdin
  [ -n "$prompt" ] && args+=(--form-string "prompt=$prompt")
  curl "${args[@]}" "$LOQ_API_URL"
}

# Learn how long a single request may be from the provider, cache the answer,
# and return the chunk length to use: min(learned, LOQ_MAX_CHUNK_SECONDS).
# Providers without a models endpoint (e.g. Groq) fall back to the default.
resolve_chunk_seconds() {
  local cap="${LOQ_MAX_CHUNK_SECONDS:-600}"
  local default="${LOQ_DEFAULT_CHUNK_SECONDS:-600}"
  local ttl="${LOQ_LIMIT_CACHE_TTL:-86400}"
  local now learned="" ts="" val="" line="" url=""
  now=$(date +%s)

  if [ -f "$LIMITS_CACHE" ]; then
    line=$(grep -F "$LOQ_API_URL"$'\t' "$LIMITS_CACHE" 2>/dev/null | tail -n 1 || true)
    if [ -n "$line" ]; then
      IFS=$'\t' read -r url ts val <<< "$line"
    fi
  fi

  if [ -n "$val" ] && [ -n "$ts" ] && [ "$((now - ts))" -lt "$ttl" ] 2>/dev/null; then
    learned="$val"
  else
    local models_url="${LOQ_API_URL%/}/models" body
    if body=$(curl -fsS --max-time 10 "$models_url" \
                -H "Authorization: Bearer $LOQ_API_KEY" 2>/dev/null); then
      learned=$(printf '%s' "$body" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for m in d.get("data", []):
    cfg = m.get("audio_config") or {}
    v = cfg.get("max_duration_seconds")
    if isinstance(v, (int, float)) and v > 0:
        print(int(v))
        break
' 2>/dev/null || true)
    fi
    if [ -n "$learned" ]; then
      printf '%s\t%s\t%s\n' "$LOQ_API_URL" "$now" "$learned" >> "$LIMITS_CACHE"
    fi
  fi

  [ -n "$learned" ] || learned="$default"

  if [ "$learned" -gt "$cap" ] 2>/dev/null; then
    printf '%s' "$cap"
  else
    printf '%s' "$learned"
  fi
}

# Transcribe an audio file. Files at or under the chunk limit go in a single
# request; longer files are split into <=chunk-second pieces and sent in order,
# each piece's transcript appended to the previous one. Echoes the transcript.
transcribe_audio() {
  local mp3="$1"
  local chunk duration
  chunk=$(resolve_chunk_seconds)

  duration=$(ffprobe -v error -show_entries format=duration \
    -of default=noprint_wrappers=1:nokey=1 "$mp3" 2>/dev/null | tr -d '\r\n' || true)
  [[ "$duration" =~ ^[0-9]+(\.[0-9]+)?$ ]] || duration=0

  # Fast path: fits in one request.
  if [ "$(echo "$duration <= $chunk" | bc -l)" = "1" ]; then
    send_audio_once "$mp3" ""
    return
  fi

  echo "[DEBUG] Audio is ${duration}s; splitting into ${chunk}s chunks" >&2
  local tmpdir
  tmpdir=$(mktemp -d "${TMP_DIR%/}/chunk.XXXXXX")
  # Re-encode while splitting so every piece is a valid, standalone MP3.
  if ! ffmpeg -v error -i "$mp3" -f segment -segment_time "$chunk" \
        -c:a libmp3lame -q:a 4 "$tmpdir/part_%03d.mp3"; then
    log_error "Failed to split audio for chunked transcription: $mp3"
    rm -rf "$tmpdir"
    return 1
  fi

  local out="" prev_tail="" part text
  for part in "$tmpdir"/part_*.mp3; do
    [ -e "$part" ] || continue
    if ! text=$(send_audio_once "$part" "$prev_tail"); then
      log_error "Chunk transcription failed: $part"
      rm -rf "$tmpdir"
      return 1
    fi
    text=$(printf '%s' "$text" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    if [ -n "$text" ]; then
      out="${out:+$out }$text"
      # Carry the transcript tail forward as context to reduce seam errors.
      prev_tail=$(printf '%s' "$text" | tail -c 200)
    fi
  done
  rm -rf "$tmpdir"
  printf '%s' "$out"
}

# Function to process an MP3 file and generate transcription
process_audio() {
  local mp3_audio="$1"
  local simulate_paste="${2:-true}"  # Optional second parameter, defaults to true
  local show_notifications="${3:-true}"  # Optional third parameter, defaults to true
  local transcript="${mp3_audio%.mp3}.txt"
  
  # Display notification for sending to Whisper API if enabled
  if [ "$show_notifications" = "true" ]; then
    close_notification
    audio_kb=$(du -k "$mp3_audio" | cut -f1)
    notify "Sending to Whisper..." "🔊 Sending $audio_kb KB audio to Whisper API"
    echo "[DEBUG] Sending $audio_kb KB audio to Whisper API"
  fi
  
  # Send audio to the transcription API, chunking automatically if the
  # recording is longer than a single request may be.
  local start_time=$(date +%s.%N)
  local response
  if ! response=$(transcribe_audio "$mp3_audio"); then
    log_error "Failed to send audio to Whisper API ($LOQ_PROVIDER @ $LOQ_API_URL)"
    exit 1
  fi
  # trim leading and trailing whitespace from response
  response=$(echo "$response" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  local end_time=$(date +%s.%N)

  # Save transcription to a text file
  echo "$response" > "$transcript"
  
  # Extract statistics from response and calculate additional stats
  local word_count=$(echo "$response" | wc -w)
  local recording_duration
  if ! recording_duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$mp3_audio" 2>/dev/null); then
    log_error "Failed to read duration for $mp3_audio"
    recording_duration="0"
  fi
  recording_duration=$(echo "$recording_duration" | tr -d '\r\n')
  if [ -z "$recording_duration" ]; then
    recording_duration="0"
  fi

  local words_per_second="0"
  local words_per_minute="0"
  if [[ "$recording_duration" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    if [ "$(echo "$recording_duration > 0" | bc -l)" = "1" ]; then
      words_per_second=$(echo "scale=6; $word_count / $recording_duration" | bc -l)
      words_per_minute=$(echo "scale=6; $words_per_second * 60" | bc -l)
    fi
  else
    log_error "Invalid duration '$recording_duration' reported for $mp3_audio"
    recording_duration="0"
  fi

  local processing_time=$(echo "$end_time - $start_time" | bc -l)
  local utc_time=$(date -u +"%Y%m%dT%H%M%SZ")
  local local_time=$(date +"%Y%m%dT%H%M%SZ")
  local microseconds_since_1970=$(date +%s%6N)
  
  # Append statistics to stats file
  if [ ! -s "$STATS_FILE" ]; then
    echo -e "Microsec_Since_1970\tUTC_Time\tLocal_Time\tDuration_Sec\tWord_Count\tWPS\tWPM\tProcessing_Sec" > "$STATS_FILE"
  fi
  echo -e "$microseconds_since_1970\t$utc_time\t$local_time\t$recording_duration\t$word_count\t$words_per_second\t$words_per_minute\t$processing_time" >> "$STATS_FILE"
  
  # Save statistics to a .stats file attached to the recording
  local stats_data=$(echo -e "$microseconds_since_1970\t$utc_time\t$local_time\t$recording_duration\t$word_count\t$words_per_second\t$words_per_minute\t$processing_time")
  echo -e "$stats_data" > "${mp3_audio%.mp3}.stats"

  if [ "$show_notifications" = "true" ]; then
    # Format stats for display
    # Force C numeric locale so decimal points are interpreted consistently
    words_per_second=$(LC_NUMERIC=C printf "%.2f" "$words_per_second")
    words_per_minute=$(LC_NUMERIC=C printf "%.2f" "$words_per_minute")
    processing_time=$(LC_NUMERIC=C printf "%.2f" "$processing_time")
    recording_duration=$(LC_NUMERIC=C printf "%.2f" "$recording_duration")
    
    # Close previous notification and show completion
    close_notification
    notify "Transcription Complete" "🔊 $word_count words / $recording_duration s, $words_per_minute wpm, processed in $processing_time s "
    echo "[DEBUG] Transcription complete: $word_count words / $recording_duration s, $words_per_minute wpm, processed in $processing_time s"
    
    # Notifications are now enabled
  fi

  # Copy response to both clipboard buffers (keep for backup method)
  echo -n "$response" | xclip -sel clip

  # Only insert text if requested
  if [ "$simulate_paste" = "true" ]; then
    # Check keyboard layout configuration
    if [ -f "$CONFIG_FILE" ] && grep -q "^KEYBOARD_LAYOUT=dvorak" "$CONFIG_FILE"; then
      # Dvorak layout: send physical . key (52) which maps to V in Dvorak
      # 29 = left ctrl, 42 = left shift, 52 = . (which is V in Dvorak)
      YDOTOOL_SOCKET="/tmp/.ydotool_socket" ydotool key 29:1 42:1 52:1 29:0 42:0 52:0
    else
      # QWERTY layout (default): send Ctrl+Shift+V directly
      # 29 = left ctrl, 42 = left shift, 47 = V
      YDOTOOL_SOCKET="/tmp/.ydotool_socket" ydotool key 29:1 42:1 47:1 29:0 42:0 47:0
    fi
  fi

}

# Function to stop recording and process the audio
stop_recording() {
  if [ ! -f "$TMP_DIR/recording.lock" ]; then
    log_error "No recording in progress"
    exit 1
  fi

  sleep 0.2 # seems we need to pad slightly for whisper to get the last word

  # Kill recording process if it exists
  if [ -f "$TMP_DIR/recording_pid" ]; then
    local pid=$(cat "$TMP_DIR/recording_pid")
    if kill -0 $pid 2>/dev/null; then
      sleep 0.1  # Small delay before killing the process
      kill $pid
    else
      echo "[DEBUG] Recording process $pid no longer exists"
    fi
  fi

  # Kill cleanup process if it exists
  if [ -f "$TMP_DIR/cleanup_pid" ]; then
    local cleanup_pid=$(cat "$TMP_DIR/cleanup_pid")
    if kill -0 $cleanup_pid 2>/dev/null; then
      kill -HUP $cleanup_pid
    else
      echo "[DEBUG] Cleanup process $cleanup_pid no longer exists"
    fi
  fi

  # Remove lock file to indicate recording is stopped
  rm -f "$TMP_DIR/recording.lock"
  
  # Remove recording-now file
  rm -f "$LOQ_DIR/recording-now"

  local audio=$(cat "$TMP_DIR/audio")
  local mp3_audio="${audio%.wav}.mp3"
  local transcript="${audio%.wav}.txt"
  
  # Convert wav to mp3
  lame -V 4 "$audio" "$mp3_audio"
  if [ $? -ne 0 ]; then
    log_error "Failed to convert wav to mp3"
    exit 1
  fi

  # Clean up wav of recording
  rm -f "$audio"
  
  # Process the converted MP3 with paste simulation
  process_audio "$mp3_audio" "true" "true"
}

# Function to toggle recording
toggle_recording() {
  if [ -f "$TMP_DIR/recording.lock" ]; then
    # If recording.lock file exists, stop the recording
    stop_recording
  else
    # If recording.lock file does not exist, start the recording
    start_recording
  fi
}

if [ ! -f "$CONFIG_FILE" ]; then
  log_error "API key not found. Please add your OpenAI API key to $CONFIG_FILE"
  exit 1
fi

source "$CONFIG_FILE"

# --- Provider resolution ---------------------------------------------------
# Pick the active provider with LOQ_PROVIDER (default: groq). Each provider
# stores its settings in LOQ_<PROVIDER>_KEY / _URL / _MODEL, e.g.
#   LOQ_PROVIDER=groq       -> LOQ_GROQ_KEY, LOQ_GROQ_URL, LOQ_GROQ_MODEL
#   LOQ_PROVIDER=lunaroute  -> LOQ_LUNAROUTE_KEY, ...
# Legacy flat LOQ_API_KEY / LOQ_API_URL / LOQ_API_MODEL are used as a fallback
# when the selected provider has no specific values set.
LOQ_PROVIDER="${LOQ_PROVIDER:-groq}"

_provider_var() {
  local name="LOQ_${LOQ_PROVIDER^^}_$1"
  printf '%s' "${!name:-}"
}

_flat_key="${LOQ_API_KEY:-}"
_flat_url="${LOQ_API_URL:-}"
_flat_model="${LOQ_API_MODEL:-}"

LOQ_API_KEY="$(_provider_var KEY)";     LOQ_API_KEY="${LOQ_API_KEY:-$_flat_key}"
LOQ_API_URL="$(_provider_var URL)";     LOQ_API_URL="${LOQ_API_URL:-$_flat_url}"
LOQ_API_MODEL="$(_provider_var MODEL)"; LOQ_API_MODEL="${LOQ_API_MODEL:-$_flat_model}"

if [ -z "${LOQ_API_KEY:-}" ]; then
  log_error "API key not found for provider '$LOQ_PROVIDER'. Please add it to $CONFIG_FILE"
  exit 1
fi

if [ -z "${LOQ_API_MODEL:-}" ]; then
  log_error "API model not found for provider '$LOQ_PROVIDER'. Please add it to $CONFIG_FILE"
  exit 1
fi

if [ -z "${LOQ_API_URL:-}" ]; then
  log_error "API URL not found for provider '$LOQ_PROVIDER'. Please add it to $CONFIG_FILE"
  exit 1
fi


if [ ! -d "$LOQ_DIR/recordings" ]; then
  mkdir -p "$LOQ_DIR/recordings"
fi

if [ ! -d "$TMP_DIR" ]; then
  mkdir -p "$TMP_DIR"
fi

if [ ! -f "$STATS_FILE" ]; then
  touch "$STATS_FILE"
fi

# if we have no args print help
if [ $# -eq 0 ]; then
  echo "Usage: $0 {start|stop|toggle}"
  exit 1
fi

# Function to redo transcription
redo_transcription() {
  local mp3_file="$1"
  
  # If no file specified, find the latest MP3 in recordings directory
  if [ -z "$mp3_file" ]; then
    mp3_file=$(find "$LOQ_DIR/recordings" -name "*.mp3" -type f -printf '%T@ %p\n' | sort -n | tail -1 | cut -f2- -d" ")
    if [ -z "$mp3_file" ]; then
      log_error "No MP3 files found in recordings directory"
      exit 1
    fi
  elif [ ! -f "$mp3_file" ]; then
    log_error "Specified file does not exist: $mp3_file"
    exit 1
  fi
  
  process_audio "$mp3_file" "false" "false"
}

# Function to reset and clean up temporary files and processes
reset_loq() {
  echo "[DEBUG] Resetting loq state..."
  
  # Kill any recording process if it exists
  if [ -f "$TMP_DIR/recording_pid" ]; then
    local pid=$(cat "$TMP_DIR/recording_pid")
    if kill -0 $pid 2>/dev/null; then
      echo "[DEBUG] Killing recording process $pid"
      kill $pid
    else
      echo "[DEBUG] Recording process $pid no longer exists"
    fi
    rm -f "$TMP_DIR/recording_pid"
  fi
  
  # Kill any cleanup process if it exists
  if [ -f "$TMP_DIR/cleanup_pid" ]; then
    local cleanup_pid=$(cat "$TMP_DIR/cleanup_pid")
    if kill -0 $cleanup_pid 2>/dev/null; then
      echo "[DEBUG] Killing cleanup process $cleanup_pid"
      kill -HUP $cleanup_pid
    else
      echo "[DEBUG] Cleanup process $cleanup_pid no longer exists"
    fi
    rm -f "$TMP_DIR/cleanup_pid"
  fi
  
  # Remove lock file if it exists
  if [ -f "$TMP_DIR/recording.lock" ]; then
    echo "[DEBUG] Removing recording lock file"
    rm -f "$TMP_DIR/recording.lock"
  fi
  
  # Remove recording-now file if it exists
  if [ -f "$LOQ_DIR/recording-now" ]; then
    echo "[DEBUG] Removing recording-now file"
    rm -f "$LOQ_DIR/recording-now"
  fi
  
  # Remove audio file reference if it exists
  if [ -f "$TMP_DIR/audio" ]; then
    echo "[DEBUG] Removing audio file reference"
    rm -f "$TMP_DIR/audio"
  fi
  
  # Remove notification ID file if it exists
  if [ -f "$TMP_DIR/notification_id" ]; then
    echo "[DEBUG] Clearing notification ID"
    echo "" > "$TMP_DIR/notification_id"
  fi
  
  echo "[DEBUG] Reset complete"
}

# Main script logic
case "$1" in
  start)
    start_recording
    ;;
  stop)
    stop_recording
    ;;
  toggle)
    toggle_recording
    ;;
  redo)
    redo_transcription "${2:-}"  # Pass second argument if it exists
    ;;
  reset)
    reset_loq
    ;;
  *)
    echo "Usage: $0 {start|stop|toggle|redo [mp3_file]|reset}"
    exit 1
    ;;
esac
